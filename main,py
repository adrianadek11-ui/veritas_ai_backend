from fastapi import FastAPI
from pydantic import BaseModel
from fastapi.staticfiles import StaticFiles

app = FastAPI()

class QueryRequest(BaseModel):
    query: str

@app.post("/api/verify")
async def verify_content(data: QueryRequest):
    # Tutaj docelowo działa Twoja logika RAG / synteza z siecią
    return {
        "status": "SUCCESS",
        "direct_answer": f"Zweryfikowano tezę z bazy RAG i sieci Web dla zapytania: '{data.query}'. Dane są zgodne z oficjalnymi raportami statystycznymi.",
        "confidence": "98.5%",
        "processing_time": "140 ms",
        "sources": [
            {
                "title": "Oficjalny Portal Statystyczny / Baza RAG Veritas",
                "url": "https://trycloudflare.com"
            }
        ]
    }

# Montowanie plików statycznych (jeśli obsługujesz folder static)
app.mount("/", StaticFiles(directory="static", html=True), name="static")
